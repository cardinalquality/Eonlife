# Production Environment Configuration
# This file contains production-specific settings
# Deploy this to your production environment

# =====================
# Environment
# =====================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://eonlife.com
NEXT_PUBLIC_API_URL=https://eonlife.com/api

# =====================
# Security
# =====================
# CRITICAL: Use strong, unique secrets for production
# Generate with: openssl rand -base64 32
# Store these in your hosting provider's secret management
API_SECRET=your-production-secret-key-here
NEXTAUTH_SECRET=your-production-nextauth-secret-here
NEXTAUTH_URL=https://eonlife.com

# =====================
# Database - Production
# =====================
# Use a production-grade database with backups and monitoring
# Recommended: Supabase, Railway, Neon, or Vercel Postgres
# Example: postgresql://user:password@production-host:5432/eonlife_production
DATABASE_URL=postgresql://user:password@production-host:5432/eonlife_production

# Connection Pool Settings (optimized for production)
DB_POOL_MIN=10
DB_POOL_MAX=30
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# =====================
# Stripe - LIVE Mode
# =====================
# CRITICAL: Use LIVE keys in production only
# Ensure these are properly secured in your hosting provider's secrets
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_your_live_publishable_key
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_production_webhook_secret

# =====================
# Rate Limiting - Production
# =====================
# REQUIRED: Use Upstash Redis for production rate limiting
UPSTASH_REDIS_URL=https://your-production-redis.upstash.io
UPSTASH_REDIS_TOKEN=your_production_redis_token

# =====================
# Email - Production
# =====================
# Use production email service with proper domain authentication
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_production_sendgrid_api_key
SMTP_FROM_EMAIL=noreply@eonlife.com

# SendGrid
SENDGRID_API_KEY=your_production_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@eonlife.com

# Mailchimp (production audience)
MAILCHIMP_API_KEY=your_production_mailchimp_api_key
MAILCHIMP_AUDIENCE_ID=production_audience_id

# =====================
# Authentication - Production
# =====================
# Use production OAuth app credentials
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret

# =====================
# Analytics - Production
# =====================
# Production analytics tracking
NEXT_PUBLIC_GA_ID=G-PRODUCTION-ID
NEXT_PUBLIC_SENTRY_DSN=your_production_sentry_dsn
SENTRY_AUTH_TOKEN=your_production_sentry_token
SENTRY_ENVIRONMENT=production
MIXPANEL_TOKEN=your_production_mixpanel_token
SEGMENT_WRITE_KEY=your_production_segment_key

# =====================
# File Storage - Production
# =====================
# Use production buckets with proper CDN configuration
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=eonlife-production
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_name
CLOUDINARY_API_KEY=your_production_cloudinary_key
CLOUDINARY_API_SECRET=your_production_cloudinary_secret

# =====================
# Feature Flags - Production
# =====================
# Enable all production features
ENABLE_NEWSLETTER=true
ENABLE_CHATBOT=true
ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_EMAIL=true

# =====================
# Provider Configuration
# =====================
NEXT_PUBLIC_FORM_PROVIDER=sendgrid
NEXT_PUBLIC_ANALYTICS_PROVIDER=google-analytics
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_EMAIL_PROVIDER=mailchimp

# =====================
# Active Product
# =====================
NEXT_PUBLIC_ACTIVE_PRODUCT=reluma

# =====================
# Production-Specific Settings
# =====================
# Minimal logging in production
LOG_LEVEL=error
DEBUG=false

# Production identifier
NEXT_PUBLIC_ENVIRONMENT=production

# =====================
# Performance & Monitoring
# =====================
# Enable production optimizations
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
