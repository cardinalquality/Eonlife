# Database Configuration
# For Supabase: Use the connection string from your Supabase project settings
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://user:password@host:5432/eonlife_db

# Connection Pool Settings (optional, uses defaults if not specified)
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=2000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
API_SECRET=your-secret-key-here

# Email Configuration (for newsletter features)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@reluma.com
SENDGRID_FROM_NAME=Reluma

# Payment Processing
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...

# Analytics & Monitoring
MIXPANEL_TOKEN=your-mixpanel-token
SEGMENT_WRITE_KEY=your-segment-write-key

# Chatbot Configuration
CHATBOT_API_KEY=your-chatbot-api-key
CHATBOT_MODEL=gpt-4

# Feature Flags
ENABLE_NEWSLETTER=true
ENABLE_CHATBOT=true
ENABLE_ANALYTICS=true

# Environment
NODE_ENV=development
