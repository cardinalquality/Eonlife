# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ===========================================
# GENERAL CONFIGURATION
# ===========================================

# Node environment
NODE_ENV=development

# Application URL (for CORS and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
API_SECRET=your-secret-key-here

# ===========================================
# RATE LIMITING (Optional - for production)
# ===========================================

# Upstash Redis for rate limiting
# Sign up at https://upstash.com for free Redis
# If not set, will use in-memory rate limiting (not suitable for multi-server deployments)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ===========================================
# DATABASE (Optional - for future features)
# ===========================================

# PostgreSQL/MySQL database connection string
# Example: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/eonlife_db

# Connection Pool Settings (optional, uses defaults if not specified)
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=2000

# ===========================================
# AUTHENTICATION (Optional - for future features)
# ===========================================

# NextAuth.js configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth providers (if using social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# EMAIL SERVICE (Optional)
# ===========================================

# SMTP Configuration for sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Eonlife

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@reluma.com
SENDGRID_FROM_NAME=Reluma

# Mailchimp for newsletter
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=us1

# ===========================================
# SECURITY MONITORING (Optional)
# ===========================================

# Sentry for error tracking
# Sign up at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ===========================================
# ANALYTICS (Optional)
# ===========================================

# Google Analytics
# Get your GA4 Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Analytics & Monitoring
MIXPANEL_TOKEN=your-mixpanel-token
SEGMENT_WRITE_KEY=your-segment-write-key

# Vercel Analytics (automatically enabled on Vercel)
# No configuration needed

# ===========================================
# FILE UPLOADS (Optional - for future features)
# ===========================================

# AWS S3 for file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloudinary (alternative to S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# PAYMENT PROCESSING (Optional - for future features)
# ===========================================

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...

# ===========================================
# CHATBOT CONFIGURATION
# ===========================================

# Chatbot Configuration
CHATBOT_API_KEY=your-chatbot-api-key
CHATBOT_MODEL=gpt-4

# ===========================================
# FEATURE FLAGS (Optional)
# ===========================================

# Enable/disable features
ENABLE_NEWSLETTER=true
ENABLE_CHATBOT=true
ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ===========================================
# SSL/HTTPS (Production only)
# ===========================================

# When deploying to Vercel/Netlify, SSL is automatic
# For custom hosting, configure your web server (nginx, apache)
# and use Let's Encrypt for free SSL certificates

# Force HTTPS in production (handled by security headers in next.config.ts)
# No additional configuration needed here
