# Development Environment Configuration
# This file contains development-specific settings
# Copy this to .env.local for local development

# =====================
# Environment
# =====================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# =====================
# Security
# =====================
API_SECRET=dev-secret-key-change-me
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# =====================
# Database - Development
# =====================
# Use a local PostgreSQL instance or a dedicated development database
# Example: postgresql://user:password@localhost:5432/eonlife_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eonlife_dev

# Connection Pool Settings (smaller for development)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# =====================
# Stripe - Test Mode
# =====================
# Use Stripe TEST keys for development
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_test_publishable_key
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# =====================
# Rate Limiting - Development
# =====================
# Leave empty to use in-memory rate limiting in development
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# =====================
# Email - Development (Console/Logging)
# =====================
# Use mailtrap.io or ethereal.email for development email testing
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=dev@eonlife.local

# SendGrid (optional for development)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=dev@eonlife.local

# Mailchimp (optional for development)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# =====================
# Authentication - Development
# =====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =====================
# Analytics - Disabled for Development
# =====================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
MIXPANEL_TOKEN=
SEGMENT_WRITE_KEY=

# =====================
# File Storage - Development
# =====================
# Use local storage or test buckets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=eonlife-dev
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================
# Feature Flags - Development
# =====================
ENABLE_NEWSLETTER=true
ENABLE_CHATBOT=true
ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_EMAIL=true

# =====================
# Provider Configuration
# =====================
NEXT_PUBLIC_FORM_PROVIDER=custom
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_EMAIL_PROVIDER=mailchimp

# =====================
# Active Product
# =====================
NEXT_PUBLIC_ACTIVE_PRODUCT=reluma

# =====================
# Development Tools
# =====================
# Enable verbose logging
DEBUG=true
LOG_LEVEL=debug
