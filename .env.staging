# Staging Environment Configuration
# This file contains staging-specific settings
# Deploy this to your staging environment (e.g., Vercel staging deployment)

# =====================
# Environment
# =====================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.eonlife.com
NEXT_PUBLIC_API_URL=https://staging.eonlife.com/api

# =====================
# Security
# =====================
# IMPORTANT: Use strong, unique secrets for staging
# Generate with: openssl rand -base64 32
API_SECRET=your-staging-secret-key-here
NEXTAUTH_SECRET=your-staging-nextauth-secret-here
NEXTAUTH_URL=https://staging.eonlife.com

# =====================
# Database - Staging
# =====================
# Use a dedicated staging database (separate from production)
# Recommended: Supabase, Railway, or Vercel Postgres
# Example: postgresql://user:password@host:5432/eonlife_staging
DATABASE_URL=postgresql://user:password@staging-host:5432/eonlife_staging

# Connection Pool Settings (moderate for staging)
DB_POOL_MIN=5
DB_POOL_MAX=15
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# =====================
# Stripe - Test Mode
# =====================
# IMPORTANT: Still use TEST keys in staging, never use live keys
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_test_publishable_key
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_staging_webhook_secret

# =====================
# Rate Limiting - Staging
# =====================
# Use Upstash Redis for realistic rate limiting testing
UPSTASH_REDIS_URL=https://your-staging-redis.upstash.io
UPSTASH_REDIS_TOKEN=your_staging_redis_token

# =====================
# Email - Staging
# =====================
# Use real email service but with test recipient lists
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM_EMAIL=staging@eonlife.com

# SendGrid
SENDGRID_API_KEY=your_staging_sendgrid_api_key
SENDGRID_FROM_EMAIL=staging@eonlife.com

# Mailchimp (use test audience)
MAILCHIMP_API_KEY=your_staging_mailchimp_api_key
MAILCHIMP_AUDIENCE_ID=staging_audience_id

# =====================
# Authentication - Staging
# =====================
# Use separate OAuth app credentials for staging
GOOGLE_CLIENT_ID=your_staging_google_client_id
GOOGLE_CLIENT_SECRET=your_staging_google_client_secret
GITHUB_CLIENT_ID=your_staging_github_client_id
GITHUB_CLIENT_SECRET=your_staging_github_client_secret

# =====================
# Analytics - Staging (Separate Property)
# =====================
# Use separate analytics properties to avoid polluting production data
NEXT_PUBLIC_GA_ID=G-STAGING-ID
NEXT_PUBLIC_SENTRY_DSN=your_staging_sentry_dsn
SENTRY_AUTH_TOKEN=your_staging_sentry_token
SENTRY_ENVIRONMENT=staging
MIXPANEL_TOKEN=your_staging_mixpanel_token
SEGMENT_WRITE_KEY=your_staging_segment_key

# =====================
# File Storage - Staging
# =====================
# Use separate buckets/folders for staging
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=eonlife-staging
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# =====================
# Feature Flags - Staging
# =====================
# Enable all features for comprehensive testing
ENABLE_NEWSLETTER=true
ENABLE_CHATBOT=true
ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_EMAIL=true

# =====================
# Provider Configuration
# =====================
NEXT_PUBLIC_FORM_PROVIDER=sendgrid
NEXT_PUBLIC_ANALYTICS_PROVIDER=google-analytics
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_EMAIL_PROVIDER=mailchimp

# =====================
# Active Product
# =====================
NEXT_PUBLIC_ACTIVE_PRODUCT=reluma

# =====================
# Staging-Specific Settings
# =====================
# Enable more verbose logging than production
LOG_LEVEL=info
DEBUG=false

# Staging identifier for UI (optional)
NEXT_PUBLIC_ENVIRONMENT=staging
